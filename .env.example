# Copy this file to .env and fill in real values. Never commit the real .env.

# --- App ---
APP_NAME=Finz Accounting Pipeline
ENVIRONMENT=development
SECRET_KEY=change-me-to-a-random-value
# Required only if you want the deployed admin reset button enabled.
# Use a long random value and keep it private.
ADMIN_RESET_TOKEN=

# --- MongoDB ---
# Use a real MongoDB URI for final runs, e.g. MongoDB Atlas:
# mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
# For local UI smoke tests only, you may use mongomock://localhost.
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=finz_accounting

# --- Gemini ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_TIMEOUT_SECONDS=15

# --- QuickBooks Online (create an app at https://developer.intuit.com) ---
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=
# For deployed apps, change this to https://YOUR_APP_URL/api/quickbooks/callback
QBO_REDIRECT_URI=http://localhost:8000/api/quickbooks/callback
QBO_ENVIRONMENT=sandbox
# Filled in after connecting via /api/quickbooks/connect -> /callback:
QBO_REALM_ID=
QBO_ACCESS_TOKEN=
QBO_REFRESH_TOKEN=

# --- Accounting ---
COMPANY_NAME=BrightFix Home Services LLC
BASE_CURRENCY=USD
FISCAL_YEAR_START_MONTH=1
ACCOUNTING_BASIS=cash
